# ── Database (production PostgreSQL, e.g. Neon / Supabase / RDS) ──
DATABASE_URL="postgresql://user:password@host:5432/kanhacloset"

# ── Site ──
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# ── Razorpay (dashboard.razorpay.com → Settings → API Keys) ──
# Key ID is public (browser); secrets stay server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"
RAZORPAY_KEY_SECRET=""
# Settings → Webhooks → add https://yourdomain.com/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# ── Auth (generate: openssl rand -base64 32) ──
AUTH_SECRET=""

# ── First admin (seeded by `npm run seed`; change before launch) ──
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD=""
